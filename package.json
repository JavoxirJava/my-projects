{
  "name": "my-projects",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4350",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4350",
    "typecheck": "tsc --noEmit",
    "worker": "node --env-file=.env.local scripts/worker.ts",
    "migrate": "node --env-file=.env.local scripts/migrate.ts",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.23.0",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
