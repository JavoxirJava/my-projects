APP_URL=http://127.0.0.1:4350
DATABASE_URL=postgresql://myprojects_app:CHANGE_ME@127.0.0.1:5432/my_projects
# Only set for migration commands, never use the migrator role in production web/worker.
# MIGRATION_DATABASE_URL=postgresql://myprojects_migrator:CHANGE_ME@127.0.0.1:5432/my_projects
# These three values are used only by the first bootstrap; remove them from production runtime afterward.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS
BACKUP_PASSWORD=CHANGE_ME_FIXED_ZIP_PASSWORD
# 32 random bytes, base64 or 64 hex characters. Keep this key safe and stable.
ENCRYPTION_KEY=CHANGE_ME
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DB_POOL_MAX=4

# Web can show bot configuration without receiving the bot token.
TELEGRAM_CONFIGURED=false
